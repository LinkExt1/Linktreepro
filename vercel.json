{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/p/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/menu",
      "destination": "/index.html"
    },
    {
      "source": "/profil",
      "destination": "/index.html"
    },
    {
      "source": "/parametres",
      "destination": "/index.html"
    },
    {
      "source": "/recours",
      "destination": "/index.html"
    },
    {
      "source": "/signaler-bug",
      "destination": "/index.html"
    },
    {
      "source": "/admin/utilisateurs",
      "destination": "/index.html"
    },
    {
      "source": "/admin/ia",
      "destination": "/index.html"
    },
    {
      "source": "/:username([A-Za-z0-9._-]+)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-cleanup",
      "schedule": "0 3 * * *"
    }
  ]
}
