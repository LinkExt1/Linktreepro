rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    function ownerSafeUserUpdate(userId) {
      return isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'role','accountStatus','status','banReason','banReasonReport','adminContactLink','isBanned','isSuspended',
        'suspensionReason','suspensionCount','adminOverride','moderationCorrection','moderationIncident','moderationReview',
        'email','uid','createdAt','updatedAt','likes','subscribers','leads','views','totalViews',
        'displayedViews','publicViews','badgeRawViews','badgeWindowViews','badgeWindowStartAt',
        'badgeEvaluationStartAt','badgeResetAt','badgeManual','verified','bannedAt','suspendedAt',
        'suspensionEndsAt','moderationCompletedAt'
      ]);
    }
    function onlyClickIncrement() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
        && request.resource.data.clicks == resource.data.clicks + 1;
    }

    match /users/{userId} {
      // Public profiles are exposed through /api/profile, which projects only public fields.
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role != 'admin'));
      allow update: if isAdmin() || ownerSafeUserUpdate(userId);
      allow delete: if isAdmin() || isOwner(userId);

      match /visitor_logs/{logId} {
        allow read, delete: if isOwner(userId) || isAdmin();
        allow create, update: if false;
      }
      match /leads/{leadId} {
        allow create: if get(/databases/$(database)/documents/users/$(userId)).data.leadCaptureEnabled == true
          && request.resource.data.keys().hasOnly(['name','contact','type','createdAt']);
        allow read, delete: if isOwner(userId) || isAdmin();
        allow update: if false;
      }
    }

    match /settings/{settingId} {
      // AI prompts, model endpoints and moderation configuration are private admin configuration.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    match /logs/{logId} { allow read, write: if isAdmin(); }
    match /blacklisted_emails/{emailId} { allow read, write: if isAdmin(); }
    match /appeals/{userId} { allow read, update, delete: if isAdmin(); allow create: if false; }
    match /appeal_verifications/{userId} { allow read, write: if false; }
    match /otp_challenges/{id} { allow read, write: if false; }
    match /otp_requests/{id} { allow read, write: if false; }
    match /public_rate_limits/{document} { allow read, write: if false; }
    match /moderation_audit_logs/{logId} { allow read, delete: if isAdmin(); allow create, update: if false; }
    match /admin_config/{document} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /admin_settings/{document} { allow read, write: if isAdmin(); }
    match /system_config/{document} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /admin_logs/{document} { allow read, write: if isAdmin(); }
    match /donations/{document} { allow read: if true; allow write: if isAdmin(); }
    match /analytics_events/{eventId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'event','userId','timestamp','userAgent','pageUrl',
          'action','linkId','platform','theme','color','count','state','status'
        ])
        && request.resource.data.event is string
        && request.resource.data.event.size() <= 100
        && request.resource.data.userId is string
        && (
          (isAuthenticated() && request.resource.data.userId == request.auth.uid) ||
          (!isAuthenticated() && request.resource.data.userId == 'anonymous')
        )
        && request.resource.data.timestamp is timestamp
        && request.resource.data.userAgent is string
        && request.resource.data.userAgent.size() <= 500
        && request.resource.data.pageUrl is string
        && request.resource.data.pageUrl.size() <= 2048
        && (!('action' in request.resource.data) || request.resource.data.action is string)
        && (!('linkId' in request.resource.data) || request.resource.data.linkId is string)
        && (!('platform' in request.resource.data) || request.resource.data.platform is string)
        && (!('theme' in request.resource.data) || request.resource.data.theme is string)
        && (!('color' in request.resource.data) || request.resource.data.color is string)
        && (!('count' in request.resource.data) || request.resource.data.count is number)
        && (!('state' in request.resource.data) || request.resource.data.state is bool)
        && (!('status' in request.resource.data) || request.resource.data.status is string);
      allow read, delete: if isAdmin();
      allow update: if false;
    }
    match /links/{document} { allow read: if true; allow create, delete: if isAdmin(); allow update: if isAdmin() || onlyClickIncrement(); }
    match /bug_reports/{reportId} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
